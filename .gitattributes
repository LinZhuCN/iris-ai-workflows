# Keep mounted Linux scripts and ObjectScript source in LF format.
* text=auto eol=lf

# 会被直接执行/编译的脚本与源码：任何平台检出都必须是 LF
*.sh         text eol=lf
*.bash       text eol=lf
*.cls        text eol=lf
*.mac        text eol=lf
*.inc        text eol=lf
*.int        text eol=lf
Dockerfile   text eol=lf
*.Dockerfile text eol=lf
*.dockerfile text eol=lf

# Text fixtures
*.csv text eol=lf
*.tsv text eol=lf

# 明确按二进制处理（不做换行转换）
*.jar   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.xlsx  binary
*.pdf   binary
